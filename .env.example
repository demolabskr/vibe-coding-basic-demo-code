# 이 파일을 .env로 복사한 뒤 값을 바꾼다. .env는 저장소에 올리지 않는다.
# 아래 값은 모두 예시값이다.

# Django
DJANGO_SECRET_KEY=예시값-여기에-긴-무작위-문자열
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 운영에서만: 내 도메인과 HTTPS 설정
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=shop.minji-books.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.minji-books.example
# DJANGO_SECURE_HSTS_SECONDS=3600
# DATABASE_URL=postgres://shop:비밀번호_예시값@db.example.com:5432/shop

# 메일: 개발 중에는 터미널에 찍힌다. 운영에서는 메일 발송 서비스의 값을 넣는다
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=예시값
# EMAIL_HOST_PASSWORD=예시값
DEFAULT_FROM_EMAIL=민지의 자료 가게 <shop@example.com>

# 운영자 메일(판매 보고를 받는다)
OWNER_EMAIL=minji@example.com

# 사이트 주소(결제창에서 돌아올 주소와 웹훅 주소에 쓴다)
SITE_URL=http://127.0.0.1:8000

# 결제 대행 서비스 키: 테스트 키만 쓴다. 이 저장소의 가상 결제 서비스는 test_ck_, test_sk_로 시작하는 키를 받는다
PAYMENT_PUBLIC_KEY=test_ck_예시값
PAYMENT_SECRET_KEY=test_sk_예시값
PAYMENT_WEBHOOK_SECRET=whsec_예시값
